# Copy to server/.env and adjust. All values are optional.

PORT=5000
# Keep on loopback unless the API must be reachable directly from other hosts
HOST=127.0.0.1
# Set to production to mark the admin session cookie as Secure (HTTPS only)
NODE_ENV=development

# DB_FILE=./server/data/wellness.db
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

ADMIN_SESSION_TTL_HOURS=12
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15
